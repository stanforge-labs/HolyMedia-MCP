# SUPERSEDED design-only template for a dedicated TEST host.
# User chose the existing VPS; use mcp-test.single-vps.nginx.conf.example.
# Never install on the production VPS or enable before DNS, TEST isolation,
# a separate certificate, and an operator-reviewed deployment approval.
# The HTTPS block must not be enabled until the certificate exists.

server {
    listen 80;
    server_name mcp-test.holymedia.kz;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/mcp-test-acme;
    }

    location / {
        return 308 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name mcp-test.holymedia.kz;
    ssl_certificate /etc/letsencrypt/live/mcp-test.holymedia.kz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mcp-test.holymedia.kz/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 1m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Authorization $http_authorization;

    # Private Streamable HTTP only. Query string profile=google_ads_write is preserved.
    location = /mcp {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 60s;
    }

    # OAuth discovery and code flow. All routes remain subject to API controls.
    location = /.well-known/oauth-protected-resource { proxy_pass http://127.0.0.1:4000; }
    location = /.well-known/oauth-protected-resource/mcp { proxy_pass http://127.0.0.1:4000; }
    location = /.well-known/oauth-authorization-server { proxy_pass http://127.0.0.1:4000; }
    location = /oauth/authorize { proxy_pass http://127.0.0.1:4000; }
    location = /oauth/authorize/continue { proxy_pass http://127.0.0.1:4000; }
    location = /oauth/authorize/transaction { proxy_pass http://127.0.0.1:4000; }
    location = /oauth/authorize/consent { proxy_pass http://127.0.0.1:4000; }
    location = /oauth/token { proxy_pass http://127.0.0.1:4000; }
    location = /oauth/register { proxy_pass http://127.0.0.1:4000; }
    location = /oauth/revoke { proxy_pass http://127.0.0.1:4000; }

    # Human login and preview approval; no broad /api or /mcp/public proxy.
    location = /api/v1/auth/csrf { proxy_pass http://127.0.0.1:4000; }
    location = /api/v1/auth/session { proxy_pass http://127.0.0.1:4000; }
    location = /api/v1/auth/login { proxy_pass http://127.0.0.1:4000; }
    location = /api/v1/auth/logout { proxy_pass http://127.0.0.1:4000; }
    location = /api/v1/mcp/public/approval { proxy_pass http://127.0.0.1:4000; }
    location = /api/v1/mcp/public/approval/view { proxy_pass http://127.0.0.1:4000; }
    location = /auth { proxy_pass http://127.0.0.1:3000; }
    location = /connect/claude { proxy_pass http://127.0.0.1:3000; }
    location = /mcp/approve { proxy_pass http://127.0.0.1:3000; }
    location = /en/auth { proxy_pass http://127.0.0.1:3000; }
    location = /en/connect/claude { proxy_pass http://127.0.0.1:3000; }
    location = /en/mcp/approve { proxy_pass http://127.0.0.1:3000; }
    location ^~ /_next/ { proxy_pass http://127.0.0.1:3000; }
    location = /icon.svg { proxy_pass http://127.0.0.1:3000; }
    location = /favicon.ico { proxy_pass http://127.0.0.1:3000; }

    location / { return 404; }
}
