{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "V2_INTEGRATION_TESTS",
    "V2_PG18_REHEARSAL",
    "V2_PG18_TEST_DATABASE_URL",
    "DATABASE_URL",
    "REDIS_URL",
    "SESSION_HASH_SECRET",
    "CORS_ORIGINS",
    "PROVIDER_CREDENTIAL_ENCRYPTION_KEYS",
    "PROVIDER_CREDENTIAL_CURRENT_KEY_VERSION",
    "PROVIDER_GOOGLE_CLIENT_ID",
    "PROVIDER_GOOGLE_CLIENT_SECRET",
    "PROVIDER_GOOGLE_REDIRECT_URI",
    "PROVIDER_GOOGLE_DEVELOPER_TOKEN",
    "PROVIDER_GOOGLE_API_VERSION",
    "PROVIDER_GOOGLE_ADS_WRITE_ENABLED",
    "PROVIDER_GOOGLE_ADS_STAGE2_WRITE_ENABLED",
    "GOOGLE_ADS_WRITE_ACCOUNT_ALLOWLIST",
    "PROVIDER_META_CLIENT_ID",
    "PROVIDER_META_CLIENT_SECRET",
    "PROVIDER_META_REDIRECT_URI",
    "PROVIDER_META_API_VERSION",
    "PROVIDER_META_ADS_MANAGEMENT_OAUTH_ENABLED",
    "PROVIDER_HTTP_TIMEOUT_MS",
    "V2_PREVIEW_ONLY",
    "V2_CONFIRMED_WRITE_ENABLED",
    "V2_WRITE_ACCOUNT_ALLOWLIST",
    "V2_WRITE_OBJECT_ALLOWLIST",
    "V2_WRITE_OPERATION_ALLOWLIST",
    "HERMES_ENABLED",
    "HERMES_MCP_URL",
    "HERMES_ALLOWED_CHAT_IDS",
    "HERMES_CHAT_ACCOUNT_BINDINGS",
    "HERMES_OPENAI_MODEL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "src/generated/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
