# Copy only to the separate VM as app.env (0600); never reuse production values.
NODE_ENV=production
# APP_ENV is not consumed by the current config schema; record intent only.
APP_ENV=staging
V2_CONFIG_STRICT=true
API_PORT=4000
# Shape: postgresql://holymedia_staging:<URL_ENCODED_STAGING_DB_PASSWORD>@postgres:5432/holymedia_public_staging
DATABASE_URL=
# Shape: redis://:<URL_ENCODED_STAGING_REDIS_PASSWORD>@redis:6379
REDIS_URL=
CORS_ORIGINS=https://v2-staging-mcp.holymedia.kz
HOLYMEDIA_PUBLIC_BASE_URL=https://v2-staging-mcp.holymedia.kz
SESSION_HASH_SECRET=
# Shape: 1:<BASE64_OF_32_NEW_STAGING_RANDOM_BYTES>
PROVIDER_CREDENTIAL_ENCRYPTION_KEYS=
PROVIDER_CREDENTIAL_CURRENT_KEY_VERSION=1
COOKIE_DOMAIN=
LOG_LEVEL=info

# All business write paths remain OFF. Do not add production allowlists.
V2_PREVIEW_ONLY=true
V2_CONFIRMED_WRITE_ENABLED=false
PUBLIC_MCP_WRITE_SCOPE_ENABLED=false
PUBLIC_MCP_CONTROLLED_WRITE_ENABLED=false
V2_META_APP_REVIEW_RENAME_ENABLED=false
V2_META_APP_REVIEW_SECOND_RENAME_ENABLED=false
PROVIDER_META_ADS_MANAGEMENT_OAUTH_ENABLED=false
SITE_AUDIT_PRODUCT_ENABLED=false

# Baseline has no provider credentials or refresh tokens. Only a new,
# staging-only Google Login OAuth client is needed for interactive auth.
# Fill these two with the NEW staging-only OAuth client ID and secret.
PROVIDER_GOOGLE_LOGIN_CLIENT_ID=
PROVIDER_GOOGLE_LOGIN_CLIENT_SECRET=
PROVIDER_GOOGLE_LOGIN_REDIRECT_URI=https://v2-staging-mcp.holymedia.kz/auth/google/callback
PROVIDER_GOOGLE_LOGIN_SCOPES=openid email profile

# Add only when a later, separately approved provider read test needs them.
# PROVIDER_META_CLIENT_ID=
# PROVIDER_META_CLIENT_SECRET=
# PROVIDER_META_REDIRECT_URI=https://v2-staging-mcp.holymedia.kz/oauth/META_ADS/callback
# PROVIDER_GOOGLE_CLIENT_ID=
# PROVIDER_GOOGLE_CLIENT_SECRET=
# PROVIDER_GOOGLE_REDIRECT_URI=https://v2-staging-mcp.holymedia.kz/oauth/GOOGLE_ADS/callback
