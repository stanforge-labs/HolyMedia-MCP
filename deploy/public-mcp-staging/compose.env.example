# Copy to /etc/holymedia-public-mcp-staging/compose.env on the separate VM.
# Keep mode 0600. Blank fields deliberately prevent docker compose config/up.
# Shape: ghcr.io/<GHCR_OWNER>/holymedia-mcp-v2-staging@sha256:<VERIFIED_DIGEST>
STAGING_IMAGE=
STAGING_APP_ENV_FILE=/etc/holymedia-public-mcp-staging/app.env
STAGING_WEB_ENV_FILE=/etc/holymedia-public-mcp-staging/web.env
STAGING_DB_PASSWORD=
STAGING_REDIS_PASSWORD=
