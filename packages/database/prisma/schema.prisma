generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider     = "postgresql"
  relationMode = "foreignKeys"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum WorkspaceAccessStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum AuditActorType {
  HUMAN
  SERVICE
}

enum ProviderId {
  GOOGLE_ADS
  GOOGLE_ANALYTICS
  META_ADS
  GOOGLE_SEARCH_CONSOLE
  YANDEX_DIRECT
  TIKTOK_ADS
  TEST_PROVIDER
}

enum ProviderConnectionStatus {
  PENDING
  CONNECTED
  DEGRADED
  REAUTH_REQUIRED
  REVOKED
  DISCONNECTED
  ERROR
}

enum ServiceTokenResourceAccessMode {
  ALL_CONNECTED
  STATIC_ALLOWLIST
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingOrderStatus {
  OPEN
  PAID
  FAILED
  CANCELED
}

enum PaymentAttemptStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
}

enum ManualConnectionRequestStatus {
  NEW
  IN_PROGRESS
  WAITING_FOR_CLIENT
  READY_FOR_CONNECTION
  COMPLETED
  CANCELED
}

enum SupportRequestStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

enum TelegramDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
  NOT_CONFIGURED
  UNCERTAIN
}

enum TariffRequestStatus {
  PENDING
  IN_REVIEW
  APPROVED
  DECLINED
  CANCELED
}

enum SiteAuditStatus {
  QUEUED
  CRAWLING
  BROWSER_ANALYSIS
  SEO_ANALYSIS
  PERFORMANCE
  AI_ANALYSIS
  REPORTING
  COMPLETED
  FAILED
}

enum SiteAuditSeverity {
  P0
  P1
  P2
  P3
}

enum SiteAuditEvidenceKind {
  MEASURED
  COMPUTED
  AI_ASSESSMENT
}

enum SiteAuditArtifactKind {
  DESKTOP_SCREENSHOT
  MOBILE_SCREENSHOT
  ANNOTATED_SCREENSHOT
  DOCX_REPORT
}

model User {
  id                       String                          @id @default(uuid()) @db.Uuid
  email                    String                          @unique @db.VarChar(320)
  name                     String                          @db.VarChar(160)
  passwordHash             String                          @map("password_hash") @db.VarChar(255)
  status                   String                          @default("active") @db.VarChar(32)
  emailVerifiedAt          DateTime?                       @map("email_verified_at")
  avatarData               Bytes?                          @map("avatar_data")
  avatarMimeType           String?                         @map("avatar_mime_type") @db.VarChar(32)
  createdAt                DateTime                        @default(now()) @map("created_at")
  updatedAt                DateTime                        @updatedAt @map("updated_at")
  memberships              WorkspaceMembership[]
  sessions                 Session[]
  emailVerifications       EmailVerification[]
  passwordResets           PasswordReset[]
  invitationsSent          WorkspaceInvitation[]           @relation("inviter")
  auditEvents              AuditEvent[]
  connections              ProviderConnection[]
  oauthStates              OAuthState[]
  siteAnalysisRecords      SiteAnalysisRecord[]
  siteAudits               SiteAudit[]
  manualConnectionRequests ManualConnectionRequest[]
  supportRequests          SupportRequest[]
  tariffRequests           TariffRequest[]
  mcpOAuthClients          McpOAuthClient[]
  mcpOAuthCodes            McpOAuthAuthorizationCode[]
  oauthTransactions        OAuthAuthorizationTransaction[]
  oauthAuthorizationCodes  OAuthAuthorizationCode[]
  oauthAccessTokens        OAuthAccessToken[]
  oauthRefreshTokens       OAuthRefreshToken[]
  serviceIdentities        ServiceIdentity[]
  directPermissionGrants   UserPermissionGrant[]           @relation("permission_grantee")
  issuedPermissionGrants   UserPermissionGrant[]           @relation("permission_grantor")
  productEvents            ProductEvent[]

  @@index([email])
  @@index([status, createdAt])
  @@map("users")
}

model AdminSession {
  id                    String    @id @default(uuid()) @db.Uuid
  tokenDigest           String    @unique @map("token_digest") @db.VarChar(128)
  credentialFingerprint String    @map("credential_fingerprint") @db.VarChar(128)
  createdAt             DateTime  @default(now()) @map("created_at")
  expiresAt             DateTime  @map("expires_at")
  lastSeenAt            DateTime  @default(now()) @map("last_seen_at")
  revokedAt             DateTime? @map("revoked_at")
  userAgent             String?   @map("user_agent") @db.VarChar(512)
  ipHash                String?   @map("ip_hash") @db.VarChar(128)

  @@index([expiresAt])
  @@map("admin_sessions")
}

model Workspace {
  id                       String                          @id @default(uuid()) @db.Uuid
  name                     String                          @db.VarChar(160)
  slug                     String                          @unique @db.VarChar(120)
  accessStatus             WorkspaceAccessStatus           @default(PENDING) @map("access_status")
  legalName                String?                         @map("legal_name") @db.VarChar(255)
  registrationNumber       String?                         @map("registration_number") @db.VarChar(64)
  registrationCountry      String                          @default("KZ") @map("registration_country") @db.VarChar(2)
  legalAddress             String?                         @map("legal_address") @db.VarChar(500)
  companyPhone             String?                         @map("company_phone") @db.VarChar(64)
  companyEmail             String?                         @map("company_email") @db.VarChar(320)
  websiteUrl               String?                         @map("website_url") @db.VarChar(500)
  onboardingCompletedAt    DateTime?                       @map("onboarding_completed_at")
  createdAt                DateTime                        @default(now()) @map("created_at")
  updatedAt                DateTime                        @updatedAt @map("updated_at")
  memberships              WorkspaceMembership[]
  invitations              WorkspaceInvitation[]
  auditEvents              AuditEvent[]
  identities               ServiceIdentity[]
  connections              ProviderConnection[]
  providerAccounts         ProviderAccount[]
  oauthStates              OAuthState[]
  siteAnalysisRecords      SiteAnalysisRecord[]
  siteAudits               SiteAudit[]
  subscriptions            WorkspaceSubscription[]
  billingOrders            BillingOrder[]
  usageRecords             UsageRecord[]
  entitlements             Entitlement[]
  manualConnectionRequests ManualConnectionRequest[]
  supportRequests          SupportRequest[]
  tariffRequests           TariffRequest[]
  mcpPreviews              McpPreview[]
  mcpOAuthClients          McpOAuthClient[]
  mcpOAuthCodes            McpOAuthAuthorizationCode[]
  oauthTransactions        OAuthAuthorizationTransaction[]
  oauthAuthorizationCodes  OAuthAuthorizationCode[]
  oauthAccessTokens        OAuthAccessToken[]
  oauthRefreshTokens       OAuthRefreshToken[]
  productEvents            ProductEvent[]

  @@index([createdAt])
  @@map("workspaces")
}

model WorkspaceMembership {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  businessTitle String?     @map("business_title") @db.VarChar(64)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, workspaceId])
  @@index([workspaceId, role])
  @@map("workspace_memberships")
}

model Permission {
  id          String                @id @default(uuid()) @db.Uuid
  key         String                @unique @db.VarChar(120)
  description String                @db.VarChar(255)
  roleLinks   RolePermission[]
  userGrants  UserPermissionGrant[]

  @@map("permissions")
}

model UserPermissionGrant {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  grantedById  String     @map("granted_by_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")
  expiresAt    DateTime?  @map("expires_at")
  revokedAt    DateTime?  @map("revoked_at")
  user         User       @relation("permission_grantee", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy    User       @relation("permission_grantor", fields: [grantedById], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([permissionId, revokedAt, expiresAt])
  @@index([grantedById])
  @@map("user_permission_grants")
}

model RolePermission {
  role         WorkspaceRole @map("role")
  permissionId String        @map("permission_id") @db.Uuid
  permission   Permission    @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([role, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenDigest String    @unique @map("token_digest") @db.VarChar(128)
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime  @map("expires_at")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  revokedAt   DateTime? @map("revoked_at")
  userAgent   String?   @map("user_agent") @db.VarChar(512)
  ipHash      String?   @map("ip_hash") @db.VarChar(128)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model EmailVerification {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenDigest String    @unique @map("token_digest") @db.VarChar(128)
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("email_verifications")
}

model PasswordReset {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenDigest String    @unique @map("token_digest") @db.VarChar(128)
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("password_resets")
}

model WorkspaceInvitation {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  inviterId   String        @map("inviter_id") @db.Uuid
  email       String        @db.VarChar(320)
  role        WorkspaceRole @default(MEMBER)
  tokenDigest String        @unique @map("token_digest") @db.VarChar(128)
  expiresAt   DateTime      @map("expires_at")
  acceptedAt  DateTime?     @map("accepted_at")
  revokedAt   DateTime?     @map("revoked_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter     User          @relation("inviter", fields: [inviterId], references: [id], onDelete: Restrict)

  @@index([workspaceId, email])
  @@index([workspaceId, expiresAt])
  @@map("workspace_invitations")
}

model ServiceIdentity {
  id          String         @id @default(uuid()) @db.Uuid
  workspaceId String?        @map("workspace_id") @db.Uuid
  createdById String?        @map("created_by_id") @db.Uuid
  name        String         @db.VarChar(160)
  createdAt   DateTime       @default(now()) @map("created_at")
  revokedAt   DateTime?      @map("revoked_at")
  workspace   Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  tokens      ServiceToken[]

  @@index([workspaceId, revokedAt])
  @@index([createdById, revokedAt])
  @@map("service_identities")
}

model ServiceToken {
  id                String          @id @default(uuid()) @db.Uuid
  serviceIdentityId String          @map("service_identity_id") @db.Uuid
  tokenDigest       String          @unique @map("token_digest") @db.VarChar(128)
  tokenPrefix       String          @map("token_prefix") @db.VarChar(32)
  name              String          @db.VarChar(160)
  scopes            Json
  accountIds        Json?           @map("account_ids")
  resourceAccessMode ServiceTokenResourceAccessMode @default(ALL_CONNECTED) @map("resource_access_mode")
  createdAt         DateTime        @default(now()) @map("created_at")
  expiresAt         DateTime?       @map("expires_at")
  revokedAt         DateTime?       @map("revoked_at")
  lastUsedAt        DateTime?       @map("last_used_at")
  serviceIdentity   ServiceIdentity @relation(fields: [serviceIdentityId], references: [id], onDelete: Cascade)
  previews          McpPreview[]

  @@index([serviceIdentityId, revokedAt])
  @@index([expiresAt])
  @@map("service_tokens")
}

model McpOAuthClient {
  id                      String                      @id @default(uuid()) @db.Uuid
  clientId                String                      @unique @map("client_id") @db.VarChar(255)
  workspaceId             String                      @map("workspace_id") @db.Uuid
  userId                  String                      @map("user_id") @db.Uuid
  clientName              String                      @map("client_name") @db.VarChar(160)
  redirectUris            Json                        @map("redirect_uris")
  scope                   String                      @default("adforge:mcp:read") @db.VarChar(120)
  tokenEndpointAuthMethod String                      @default("client_secret_basic") @map("token_endpoint_auth_method") @db.VarChar(40)
  clientSecretDigest      String                      @unique @map("client_secret_digest") @db.VarChar(128)
  clientSecretPrefix      String                      @map("client_secret_prefix") @db.VarChar(32)
  status                  String                      @default("active") @db.VarChar(32)
  createdAt               DateTime                    @default(now()) @map("created_at")
  revokedAt               DateTime?                   @map("revoked_at")
  workspace               Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                    User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorizationCodes      McpOAuthAuthorizationCode[]

  @@index([workspaceId, status])
  @@index([userId, status])
  @@map("mcp_oauth_clients")
}

model McpOAuthAuthorizationCode {
  id                  String         @id @default(uuid()) @db.Uuid
  codeDigest          String         @unique @map("code_digest") @db.VarChar(128)
  clientId            String         @map("client_id") @db.Uuid
  workspaceId         String         @map("workspace_id") @db.Uuid
  userId              String         @map("user_id") @db.Uuid
  sessionId           String         @map("session_id") @db.Uuid
  redirectUri         String         @map("redirect_uri") @db.VarChar(2000)
  scope               String         @db.VarChar(120)
  codeChallenge       String         @map("code_challenge") @db.VarChar(200)
  codeChallengeMethod String         @default("S256") @map("code_challenge_method") @db.VarChar(16)
  expiresAt           DateTime       @map("expires_at")
  usedAt              DateTime?      @map("used_at")
  createdAt           DateTime       @default(now()) @map("created_at")
  client              McpOAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workspace           Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId, expiresAt, usedAt])
  @@index([workspaceId, userId, expiresAt])
  @@map("mcp_oauth_authorization_codes")
}

model OAuthPublicClient {
  id                      String                          @id @default(uuid()) @db.Uuid
  clientId                String                          @unique @map("client_id") @db.VarChar(255)
  clientName              String                          @map("client_name") @db.VarChar(160)
  redirectUris            Json                            @map("redirect_uris")
  scope                   String                          @default("adforge:mcp:read") @db.VarChar(120)
  tokenEndpointAuthMethod String                          @default("none") @map("token_endpoint_auth_method") @db.VarChar(40)
  applicationType         String                          @default("web") @map("application_type") @db.VarChar(16)
  registrationSource      String                          @default("dcr") @map("registration_source") @db.VarChar(16)
  metadataEtag            String?                         @map("metadata_etag") @db.VarChar(512)
  metadataFetchedAt       DateTime?                       @map("metadata_fetched_at")
  metadataExpiresAt       DateTime?                       @map("metadata_expires_at")
  status                  String                          @default("active") @db.VarChar(32)
  createdAt               DateTime                        @default(now()) @map("created_at")
  revokedAt               DateTime?                       @map("revoked_at")
  transactions            OAuthAuthorizationTransaction[]
  authorizationCodes      OAuthAuthorizationCode[]
  accessTokens            OAuthAccessToken[]
  refreshTokens           OAuthRefreshToken[]

  @@map("oauth_public_clients")
}

model OAuthAuthorizationTransaction {
  id                  String            @id @default(uuid()) @db.Uuid
  clientId            String            @map("client_id") @db.Uuid
  redirectUri         String            @map("redirect_uri") @db.VarChar(2000)
  state               String?           @db.VarChar(1000)
  scope               String            @db.VarChar(120)
  resource            String            @db.VarChar(2000)
  codeChallenge       String            @map("code_challenge") @db.VarChar(200)
  codeChallengeMethod String            @default("S256") @map("code_challenge_method") @db.VarChar(16)
  userId              String?           @map("user_id") @db.Uuid
  workspaceId         String?           @map("workspace_id") @db.Uuid
  createdAt           DateTime          @default(now()) @map("created_at")
  expiresAt           DateTime          @map("expires_at")
  consumedAt          DateTime?         @map("consumed_at")
  client              OAuthPublicClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user                User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace           Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([clientId, expiresAt, consumedAt])
  @@index([userId, workspaceId, expiresAt])
  @@map("oauth_authorization_transactions")
}

model OAuthAuthorizationCode {
  id                  String            @id @default(uuid()) @db.Uuid
  codeDigest          String            @unique @map("code_digest") @db.VarChar(128)
  clientId            String            @map("client_id") @db.Uuid
  workspaceId         String            @map("workspace_id") @db.Uuid
  userId              String            @map("user_id") @db.Uuid
  redirectUri         String            @map("redirect_uri") @db.VarChar(2000)
  scope               String            @db.VarChar(120)
  resource            String            @db.VarChar(2000)
  codeChallenge       String            @map("code_challenge") @db.VarChar(200)
  codeChallengeMethod String            @default("S256") @map("code_challenge_method") @db.VarChar(16)
  expiresAt           DateTime          @map("expires_at")
  usedAt              DateTime?         @map("used_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  client              OAuthPublicClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workspace           Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId, expiresAt, usedAt])
  @@index([workspaceId, userId, expiresAt])
  @@map("oauth_authorization_codes")
}

model OAuthAccessToken {
  id              String            @id @default(uuid()) @db.Uuid
  tokenDigest     String            @unique @map("token_digest") @db.VarChar(128)
  tokenPrefix     String            @map("token_prefix") @db.VarChar(32)
  clientId        String            @map("client_id") @db.Uuid
  workspaceId     String            @map("workspace_id") @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  scope           String            @db.VarChar(120)
  resource        String            @db.VarChar(2000)
  refreshFamilyId String?           @map("refresh_family_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at")
  expiresAt       DateTime          @map("expires_at")
  revokedAt       DateTime?         @map("revoked_at")
  lastUsedAt      DateTime?         @map("last_used_at")
  client          OAuthPublicClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, revokedAt, expiresAt])
  @@index([clientId, userId])
  @@index([refreshFamilyId, revokedAt])
  @@map("oauth_access_tokens")
}

model OAuthRefreshToken {
  id          String            @id @default(uuid()) @db.Uuid
  tokenDigest String            @unique @map("token_digest") @db.VarChar(128)
  tokenPrefix String            @map("token_prefix") @db.VarChar(32)
  familyId    String            @map("family_id") @db.Uuid
  clientId    String            @map("client_id") @db.Uuid
  workspaceId String            @map("workspace_id") @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  scope       String            @db.VarChar(120)
  resource    String            @db.VarChar(2000)
  createdAt   DateTime          @default(now()) @map("created_at")
  expiresAt   DateTime          @map("expires_at")
  usedAt      DateTime?         @map("used_at")
  revokedAt   DateTime?         @map("revoked_at")
  client      OAuthPublicClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId, revokedAt, expiresAt])
  @@index([clientId, userId, workspaceId])
  @@map("oauth_refresh_tokens")
}

model McpPreview {
  id                 String          @id @default(uuid()) @db.Uuid
  workspaceId        String          @map("workspace_id") @db.Uuid
  serviceTokenId     String          @map("service_token_id") @db.Uuid
  provider           ProviderId
  accountId          String          @map("account_id") @db.Uuid
  externalObjectId   String          @map("external_object_id") @db.VarChar(160)
  operation          String          @db.VarChar(80)
  payload            Json
  diff               Json
  previewTokenDigest String          @unique @map("preview_token_digest") @db.VarChar(128)
  expiresAt          DateTime        @map("expires_at")
  confirmedAt        DateTime?       @map("confirmed_at")
  consumedAt         DateTime?       @map("consumed_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  workspace          Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  serviceToken       ServiceToken    @relation(fields: [serviceTokenId], references: [id], onDelete: Cascade)
  account            ProviderAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([workspaceId, expiresAt, consumedAt])
  @@index([serviceTokenId, createdAt])
  @@index([accountId, operation])
  @@map("mcp_previews")
}

model AuditEvent {
  id          String         @id @default(uuid()) @db.Uuid
  workspaceId String?        @map("workspace_id") @db.Uuid
  actorUserId String?        @map("actor_user_id") @db.Uuid
  actorType   AuditActorType @default(HUMAN) @map("actor_type")
  eventType   String         @map("event_type") @db.VarChar(120)
  success     Boolean        @default(true)
  targetType  String?        @map("target_type") @db.VarChar(120)
  targetId    String?        @map("target_id") @db.VarChar(160)
  requestId   String?        @map("request_id") @db.VarChar(128)
  metadata    Json?
  createdAt   DateTime       @default(now()) @map("created_at")
  workspace   Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actorUser   User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([eventType, createdAt])
  @@map("audit_events")
}

model ProductEvent {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  eventName   String    @map("event_name") @db.VarChar(120)
  properties  Json?
  requestId   String?   @map("request_id") @db.VarChar(128)
  occurredAt  DateTime  @default(now()) @map("occurred_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

