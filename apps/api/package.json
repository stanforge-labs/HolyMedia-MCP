    "@holymedia/contracts": "workspace:*",
    "@holymedia/database": "workspace:*",
    "@holymedia/observability": "workspace:*",
    "@holymedia/site-audit": "workspace:*",
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-fastify": "11.2.4",
    "@nestjs/swagger": "11.4.7",
    "argon2": "0.45.1",
    "bullmq": "6.1.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "docx": "^9.7.1",
    "fastify": "5.12.2",
    "ioredis": "6.0.0",
